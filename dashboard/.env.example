# Password for the dashboard login page.
DASHBOARD_PASSWORD=
# Random string, at least 32 characters, used to sign the session cookie.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Base URL of the bridge-api Cloudflare worker. Leave empty to show sample data.
FORECAST_API_URL=
# Value sent as the X-Api-Key header to the worker.
FORECAST_API_KEY=
# "morning" (default) reads /v1/morning?date=YYYYMMDD.
# "datajson" reads FORECAST_API_URL?date=YYYYMMDD returning the raw R2 data.json.
FORECAST_API_MODE=morning

HOME_PORT=Conwy
# Inshore waters areas to show from data.json (datajson mode only).
INSHORE_AREAS=10,11
# datajson mode only: set to false once the tidal worker stops adding 1 hour all year.
LEGACY_TIDE_FIX=true
