<div class="layout layout--top layout--stretch">
<div class="sb">
  {% for a in alerts limit: 1 %}
  <div class="alert {{ a.level }} grow" style="flex-direction: column; align-items: flex-start; justify-content: center;"><div class="lg clamp2">{% if a.level == 'warning' %}&#9888; {% endif %}{{ a.title }}</div><div class="xs clamp2">{{ a.detail }}</div></div>
  {% else %}<div class="panel grow"><div class="body lg">No alerts</div></div>{% endfor %}
</div>
</div>
<div class="title_bar"><span class="title">Boat alerts</span><span class="instance">{{ alert_count }} active</span></div>
