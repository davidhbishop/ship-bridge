<div class="layout layout--top layout--stretch">
<div class="sb">
  {% for a in alerts limit: 4 %}
  <div class="alert {{ a.level }} {% if forloop.first %}grow{% endif %}" style="{% if forloop.first %}flex-direction: column; justify-content: center; align-items: flex-start;{% endif %}">
    {% if forloop.first %}
      <div class="label">{% if a.level == 'warning' %}&#9888; Warning{% else %}Caution{% endif %}</div>
      <div class="xl">{{ a.title }}</div>
      <div class="md clamp3">{{ a.detail }}</div>
    {% else %}
      <span class="mark">{% if a.level == 'warning' %}&#9888;{% else %}!{% endif %}</span>
      <div class="grow"><div class="md clip">{{ a.title }}</div><div class="sm clip">{{ a.detail }}</div></div>
    {% endif %}
  </div>
  {% else %}
  <div class="panel grow"><div class="body xl" style="padding-top: 120px; text-align: center;">No alerts</div></div>
  {% endfor %}
  {% if gate.known %}<div class="sm fixed">Gate {{ gate.status | downcase }} &middot; {{ gate.headline }}</div>{% endif %}
</div>
</div>
<div class="title_bar">
  <span class="title">Boat alerts &middot; {{ port }}</span>
  <span class="instance">{{ alert_count }} active &middot; updated {{ updated }}</span>
</div>
