<div class="layout layout--top layout--stretch">
<div class="sb">
  {% if forecast.warning != '' %}
  <div class="alert warning"><span class="mark">&#9888;</span><div class="grow lg clamp2">{{ forecast.warning }}</div></div>
  {% endif %}
  {% if forecast.known %}
  <div class="row fixed" style="align-items: baseline; justify-content: space-between;">
    <span class="lg clip">{{ forecast.area_short }}</span>
    <span class="sm fixed">Area {{ forecast.area_number }} &middot; {{ forecast.issued }}{% if forecast.stale %} (old){% endif %}</span>
  </div>
  <div class="panel grow">
    <div class="cap"><span>Wind</span>{% if forecast.max_force %}<span>max force {{ forecast.max_force }}</span>{% endif %}</div>
    <div class="body lg clamp3">{{ forecast.wind }}</div>
  </div>
  <div class="panel grow">
    <div class="cap"><span>Sea state</span></div>
    <div class="body lg clamp2">{{ forecast.sea }}</div>
  </div>
  <div class="row grow">
    <div class="panel grow">
      <div class="cap"><span>Weather</span></div>
      <div class="body md clamp3">{{ forecast.weather }}</div>
    </div>
    <div class="panel grow">
      <div class="cap"><span>Visibility</span></div>
      <div class="body md clamp3">{{ forecast.visibility }}</div>
    </div>
  </div>
  {% else %}
  <div class="panel grow"><div class="cap"><span>Inshore forecast</span></div><div class="body xl" style="padding-top: 100px; text-align: center;">No forecast in R2 today</div></div>
  {% endif %}
</div>
</div>
<div class="title_bar">
  <span class="title">Inshore waters forecast</span>
  <span class="instance">For the log &middot; updated {{ updated }}</span>
</div>
